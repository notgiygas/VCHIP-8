section .bss

dbg_rect_buf:     resb 16
dbg_line_buf:     resb 128
dbg_vlabel_buf:   resb 8
dbg_stack_y:      resd 1
debug_mode_enabled: resd 1

section .text

strlen_of:
    push rcx
    xor ecx, ecx
.loop:
    cmp byte [rsi+rcx], 0
    je .done
    inc ecx
    jmp .loop
.done:
    mov eax, ecx
    pop rcx
    ret

copy_cstr:
    push rax
.loop:
    mov al, [rsi]
    mov [rdi], al
    inc rsi
    inc rdi
    test al, al
    jnz .loop
    pop rax
    ret

copy_cstr_capped:
    push rax
    push rdx
    xor edx, edx
.loop:
    cmp edx, ecx
    jae .cap
    mov al, [rsi+rdx]
    mov [rdi+rdx], al
    test al, al
    jz .done
    inc edx
    jmp .loop
.cap:
    mov byte [rdi+rdx], 0
    jmp .ret
.done:
.ret:
    pop rdx
    pop rax
    ret

strcat_cstr:
    push rax
    push rdi
    push rsi
    push rcx
    mov rcx, rsi
.findend:
    cmp byte [rdi], 0
    je .found
    inc rdi
    jmp .findend
.found:
    mov rsi, rcx
    call copy_cstr
    pop rcx
    pop rsi
    pop rdi
    pop rax
    ret

append_hex_digits:
    push rax
    push rcx
    push rdx
    push r8
    push r9

    mov r9d, ecx
    dec r9d
.loop:
    mov ecx, r9d
    imul ecx, ecx, 4
    mov edx, eax
    shr edx, cl
    and edx, 0xF
    cmp edx, 9
    jbe .digit
    add edx, 'A'-10
    jmp .store
.digit:
    add edx, '0'
.store:
    mov [rdi], dl
    inc rdi
    dec r9d
    jns .loop
    mov byte [rdi], 0

    pop r9
    pop r8
    pop rdx
    pop rcx
    pop rax
    ret

draw_char:
    push rax
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push r9
    push r10
    push r11
    push r12
    push r13

    mov r12, rdi
    mov r13, rsi

    mov eax, edx
    sub eax, 32
    cmp eax, 0
    jl .skip
    cmp eax, 95
    jge .skip

    imul eax, eax, 7
    lea rbx, [rel debug_font5x7]
    add rbx, rax

    xor r10d, r10d
.rowloop:
    cmp r10d, 7
    jge .skip
    movzx r11d, byte [rbx + r10]
    xor r9d, r9d
.colloop:
    cmp r9d, 5
    jge .rownext
    mov ecx, 7
    sub ecx, r9d
    mov eax, r11d
    shr eax, cl
    and eax, 1
    test eax, eax
    jz .colnext
    mov edi, r12d
    mov eax, r9d
    imul eax, eax, DEBUG_PX
    add edi, eax
    mov esi, r13d
    mov eax, r10d
    imul eax, eax, DEBUG_PX
    add esi, eax
    mov edx, DEBUG_PX
    mov ecx, DEBUG_PX
    call draw_rect
.colnext:
    inc r9d
    jmp .colloop
.rownext:
    inc r10d
    jmp .rowloop
.skip:
    pop r13
    pop r12
    pop r11
    pop r10
    pop r9
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
    pop rax
    ret

draw_string:
    push rax
    push rbx
    push rdx
    push r12
    push r13

    mov r12d, edi
    mov r13d, esi
    mov rbx, rdx
.loop:
    movzx eax, byte [rbx]
    test al, al
    jz .done
    mov edi, r12d
    mov esi, r13d
    mov edx, eax
    call draw_char
    add r12d, (5+1)*DEBUG_PX
    inc rbx
    jmp .loop
.done:
    pop r13
    pop r12
    pop rdx
    pop rbx
    pop rax
    ret

dbg_draw_labeled_hex:
    push rax
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push r8
    push r9
    push r12
    push r13

    mov r12, rdi
    mov r13, rsi
    mov r9d, ecx
    mov rbx, rdx

    lea rdi, [rel dbg_line_buf]
    mov byte [rdi], 0
    mov rsi, rbx
    call strcat_cstr

    lea rdi, [rel dbg_line_buf]
    lea rsi, [rel dbg_0x_prefix]
    call strcat_cstr

    lea rdi, [rel dbg_line_buf]
.findend:
    cmp byte [rdi], 0
    je .foundend
    inc rdi
    jmp .findend
.foundend:
    mov eax, r9d
    mov ecx, r8d
    call append_hex_digits

    mov rdi, r12
    mov rsi, r13
    lea rdx, [rel dbg_line_buf]
    call draw_string

    pop r13
    pop r12
    pop r9
    pop r8
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
    pop rax
    ret

render_stack_line:
    push rax
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push r8

    lea rdi, [rel dbg_line_buf]
    mov byte [rdi], 0
    lea rsi, [rel dbg_stack_label]
    call strcat_cstr

    mov ebx, [chip8_sp]
    test ebx, ebx
    jnz .has_entries
    lea rdi, [rel dbg_line_buf]
    lea rsi, [rel dbg_empty_label]
    call strcat_cstr
    jmp .render

.has_entries:
    xor ecx, ecx
    lea r8, [rel chip8_stack]
.entryloop:
    cmp ecx, ebx
    jge .render
    mov edx, [r8 + rcx*4]

    lea rdi, [rel dbg_line_buf]
    lea rsi, [rel dbg_0x_prefix]
    call strcat_cstr

    lea rdi, [rel dbg_line_buf]
.findend:
    cmp byte [rdi], 0
    je .foundend
    inc rdi
    jmp .findend
.foundend:
    mov eax, edx
    push rcx
    mov ecx, 3
    call append_hex_digits
    pop rcx

    lea rdi, [rel dbg_line_buf]
    lea rsi, [rel dbg_space]
    call strcat_cstr

    inc ecx
    jmp .entryloop

.render:
    mov edi, 16
    mov esi, [dbg_stack_y]
    lea rdx, [rel dbg_line_buf]
    call draw_string

    pop r8
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
    pop rax
    ret

render_debug_overlay:
    push rax
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push r8
    push r9
    push r14
    push r15

    mov edi, 220
    mov esi, 30
    mov edx, 30
    call set_debug_color

    mov edi, 16
    mov esi, 16
    lea rdx, [rel dbg_label_pc]
    mov ecx, [chip8_pc]
    mov r8d, 3
    call dbg_draw_labeled_hex

    mov edi, 16
    mov esi, 48
    lea rdx, [rel dbg_label_i]
    mov ecx, [chip8_I]
    mov r8d, 3
    call dbg_draw_labeled_hex

    mov edi, 16
    mov esi, 80
    lea rdx, [rel dbg_label_dt]
    mov ecx, [chip8_delay]
    mov r8d, 2
    call dbg_draw_labeled_hex

    mov edi, 16
    mov esi, 112
    lea rdx, [rel dbg_label_st]
    mov ecx, [chip8_sound]
    mov r8d, 2
    call dbg_draw_labeled_hex

    mov edi, 16
    mov esi, 144
    lea rdx, [rel dbg_label_op]
    mov ecx, [chip8_last_opcode]
    mov r8d, 4
    call dbg_draw_labeled_hex

    mov eax, [current_scale]
    imul eax, eax, 64
    sub eax, 192
    mov r14d, eax

    lea rbx, [rel chip8_V]
    xor r15d, r15d
.vloop:
    cmp r15d, 16
    jge .vdone

    lea rdi, [rel dbg_vlabel_buf]
    mov eax, r15d
    mov byte [rdi], 'V'
    cmp eax, 9
    jbe .vdig
    add eax, 'A'-10
    jmp .vst
.vdig:
    add eax, '0'
.vst:
    mov [rdi+1], al
    mov byte [rdi+2], ':'
    mov byte [rdi+3], ' '
    mov byte [rdi+4], 0

    mov edi, r14d
    mov esi, r15d
    imul esi, esi, 32
    add esi, 16
    lea rdx, [rel dbg_vlabel_buf]
    movzx ecx, byte [rbx + r15]
    mov r8d, 2
    call dbg_draw_labeled_hex

    inc r15d
    jmp .vloop
.vdone:

    mov eax, [current_scale]
    imul eax, eax, 32
    sub eax, 40
    mov [dbg_stack_y], eax
    call render_stack_line

    pop r15
    pop r14
    pop r9
    pop r8
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
    pop rax
    ret
